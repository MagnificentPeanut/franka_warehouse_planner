<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="test_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <gravity>0 0 -9.8</gravity>

    <model name="box">
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
      </link>
      <plugin filename="libignition-gazebo-detachable-joint-system.so" name="ignition::gazebo::systems::DetachableJoint">
        <parent_link>link</parent_link>
        <child_model>arm</child_model>
        <child_link>link</child_link>
        <attach_topic>/box/attach</attach_topic>
        <detach_topic>/box/detach</detach_topic>
      </plugin>
    </model>
  </world>
</sdf>
